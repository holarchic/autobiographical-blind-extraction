{
 "type": "object",
 "properties": {
  "constructs": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^C[0-9]{2}$"
     },
     "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
     },
     "kind": {
      "type": "string",
      "enum": [
       "trait",
       "event"
      ]
     },
     "definition": {
      "type": "string",
      "minLength": 10,
      "maxLength": 400
     },
     "sufficiency_rule": {
      "type": "string",
      "minLength": 10,
      "maxLength": 300
     },
     "trace": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^c[0-9]{3,4}$"
      },
      "minItems": 1
     }
    },
    "required": [
     "id",
     "name",
     "kind",
     "definition",
     "sufficiency_rule",
     "trace"
    ],
    "additionalProperties": false
   },
   "maxItems": 80
  },
  "appendix": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "candidate_ref": {
      "type": "string",
      "pattern": "^c[0-9]{3,4}$"
     },
     "disposition": {
      "type": "string",
      "enum": [
       "merged",
       "split",
       "excluded"
      ]
     },
     "reason": {
      "type": "string",
      "maxLength": 300
     }
    },
    "required": [
     "candidate_ref",
     "disposition",
     "reason"
    ],
    "additionalProperties": false
   }
  }
 },
 "required": [
  "constructs",
  "appendix"
 ],
 "additionalProperties": false
}
